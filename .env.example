# Environment variables for crypto risk-management pipeline.
# Copy this file to .env and fill in your real keys.

# London Strategic Edge API (https://londonstrategicedge.com/api-documentation/)
# Required if you want to fetch live crypto data via the LSE API.
# Plan at writing: 200 calls/min, 50 GB/month, 5000 rows/request.
# SDK name on PyPI: lse-data  (it reads LSE_API_KEY by default)
LSE_API_KEY=your_lse_key_here

# Optional: yfinance for equities / FX data (no key required, rate-limited)
# YF_PROXY=

# Optional: custom data dirs
# DATA_DIR=./data
# OUTPUT_DIR=./outputs
